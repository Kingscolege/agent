{
  "engineering-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/run-hook.sh pre-tool-safety",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "engineering-session-bootstrap": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/run-hook.sh session-start",
        "timeout": 15
      }
    ]
  },
  "engineering-beast-mode": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/run-hook.sh pre-invocation-beast",
        "timeout": 15
      }
    ]
  }
}
